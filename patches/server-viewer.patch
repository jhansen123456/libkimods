diff --git a/lib/Libki/Controller/Administration/API/ScreenViewer.pm b/lib/Libki/Controller/Administration/API/ScreenViewer.pm
new file mode 100644
index 0000000..781d4a6
--- /dev/null
+++ b/lib/Libki/Controller/Administration/API/ScreenViewer.pm
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: AGPL-3.0-or-later
+# Copyright 2026 City of Clinton, Iowa
+package Libki::Controller::Administration::API::ScreenViewer;
+
+use Moose;
+use namespace::autoclean;
+
+use JSON qw(to_json);
+use Libki::ScreenViewer qw(mint_token normalize_reason);
+
+BEGIN { extends 'Catalyst::Controller'; }
+
+sub token : Path('token') : Args(0) {
+    my ( $self, $c ) = @_;
+
+    $self->_no_store($c);
+    return $self->_error( $c, 403, 'Staff administrator access is required' )
+        unless $c->user_exists && $c->check_user_roles('admin')
+            && $c->user->instance eq $c->instance;
+
+    return $self->_error( $c, 405, 'POST is required' )
+        unless uc( $c->request->method // q{} ) eq 'POST';
+
+    my $config = $c->config->{'Libki::ScreenViewer'} || { enabled => 0 };
+    return $self->_error( $c, 404, 'Screen viewing is not enabled' )
+        unless $config->{enabled};
+
+    return $self->_error( $c, 404, 'Screen viewing is not enabled for this instance' )
+        unless $c->instance eq $config->{instance};
+
+    # An explicit HTTPS origin avoids trusting forwarded Host headers.
+    # A cross-origin form cannot set X-Requested-With; do not enable CORS here.
+    return $self->_error( $c, 403, 'Same-origin viewer request is required' )
+        unless ($c->request->headers->header('Origin') // q{}) eq $config->{origin}
+            && ($c->request->headers->header('X-Requested-With') // q{}) eq 'XMLHttpRequest';
+
+    my $client_name = $c->request->params->{client} // q{};
+    return $self->_error( $c, 404, 'Screen viewing is not enabled for that client' )
+        unless $config->{clients}->{$client_name};
+
+    my $reason = eval {
+        normalize_reason( $c->request->params->{reason} );
+    };
+    return $self->_error( $c, 400, 'Select a valid reason for viewing this screen' )
+        unless $reason;
+
+    my $client = $c->model('DB::Client')->find(
+        {
+            instance => $c->instance,
+            name     => $client_name,
+        }
+    );
+    return $self->_error( $c, 404, 'Client was not found' ) unless $client;
+
+    my $staff_username = eval { $c->user->username } // 'unknown';
+    my $session = $client->session;
+    my $patron_notice_queued = 0;
+
+    if ($session) {
+        my $notice_created = eval {
+            $c->model('DB::Message')->create(
+                {
+                    content => join(
+                        q{ },
+                        'Library staff requested permission to view this screen for:',
+                        $reason->{label} . q{.},
+                        'The connection is view-only; staff cannot use your keyboard or mouse.',
+                        'Please accept or reject the connection prompt shown on this computer.',
+                    ),
+                    instance => $c->instance,
+                    user_id  => $session->user->id,
+                }
+            );
+            1;
+        };
+        return $self->_error( $c, 503, 'Unable to notify the active patron' )
+            unless $notice_created;
+        $patron_notice_queued = 1;
+    }
+
+    my $audit_created = eval {
+        $c->model('DB::Statistic')->create(
+            {
+                action      => 'SCREEN_VIEW_REQUESTED',
+                client_name => $client_name,
+                created_on  => $c->now,
+                info        => to_json(
+                    {
+                        endpoint_consent_required => 1,
+                        mode                      => 'view-only',
+                        patron_notice_queued      => $patron_notice_queued,
+                        reason                    => $reason->{code},
+                        reason_label              => $reason->{label},
+                        remote_address => $c->request->address // 'unknown',
+                    }
+                ),
+                instance   => $c->instance,
+                session_id => $c->sessionid,
+                username   => $staff_username,
+            }
+        );
+        1;
+    };
+    return $self->_error( $c, 503, 'Unable to record the screen-view audit event' )
+        unless $audit_created;
+
+    my $token = mint_token( $config, $client_name );
+
+    $c->stash(
+        {
+            client       => $client_name,
+            expires_in   => $config->{token_ttl},
+            endpoint_consent_required => 1,
+            mode         => 'view-only',
+            patron_notice_queued => $patron_notice_queued,
+            reason       => $reason->{code},
+            reason_label => $reason->{label},
+            token        => $token,
+            vnc_password => $config->{clients}->{$client_name}->{password},
+        }
+    );
+    $c->forward( $c->view('JSON') );
+}
+
+sub _error {
+    my ( $self, $c, $status, $message ) = @_;
+
+    $c->response->status($status);
+    $c->stash( { error => $message } );
+    $c->forward( $c->view('JSON') );
+    return;
+}
+
+sub _no_store {
+    my ( $self, $c ) = @_;
+
+    $c->response->headers->header( 'Cache-Control' => 'no-store, private' );
+    $c->response->headers->header( 'Pragma'        => 'no-cache' );
+    $c->response->headers->header( 'X-Content-Type-Options' => 'nosniff' );
+    $c->response->headers->header( 'Referrer-Policy' => 'no-referrer' );
+}
+
+__PACKAGE__->meta->make_immutable;
+
+1;
diff --git a/lib/Libki/ScreenViewer.pm b/lib/Libki/ScreenViewer.pm
new file mode 100644
index 0000000..b332fc4
--- /dev/null
+++ b/lib/Libki/ScreenViewer.pm
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: AGPL-3.0-or-later
+# Copyright 2026 City of Clinton, Iowa
+package Libki::ScreenViewer;
+
+use strict;
+use warnings;
+
+use Carp qw(croak);
+use Digest::SHA qw(hmac_sha256_hex);
+use Exporter qw(import);
+
+our @EXPORT_OK = qw(config_from_env mint_token normalize_reason viewer_reasons);
+
+my @VIEWER_REASON_CODES = qw(
+    patron_assistance
+    technical_troubleshooting
+    policy_safety_review
+    accessibility_assistance
+);
+
+my %VIEWER_REASON_LABELS = (
+    patron_assistance         => 'Patron requested assistance',
+    technical_troubleshooting => 'Technical troubleshooting',
+    policy_safety_review      => 'Computer-use policy or safety review',
+    accessibility_assistance  => 'Accessibility assistance',
+);
+
+sub viewer_reasons {
+    return map {
+        {
+            code  => $_,
+            label => $VIEWER_REASON_LABELS{$_},
+        }
+    } @VIEWER_REASON_CODES;
+}
+
+sub normalize_reason {
+    my ($reason_code) = @_;
+
+    $reason_code //= q{};
+    croak 'a supported screen-view reason is required'
+        unless exists $VIEWER_REASON_LABELS{$reason_code};
+
+    return {
+        code  => $reason_code,
+        label => $VIEWER_REASON_LABELS{$reason_code},
+    };
+}
+
+sub config_from_env {
+    my ($env) = @_;
+    $env ||= \%ENV;
+
+    my $enabled = ( $env->{LIBKI_VIEWER_ENABLED} // q{} )
+        =~ /\A(?:1|true|yes|on)\z/i ? 1 : 0;
+
+    return { enabled => 0, clients => {} } unless $enabled;
+
+    for my $required (
+        qw/LIBKI_VIEWER_ORIGIN LIBKI_VIEWER_CLIENT_NAME LIBKI_VIEWER_HMAC_FILE LIBKI_VIEWER_PASSWORD_FILE/
+      )
+    {
+        croak "$required is required when LIBKI_VIEWER_ENABLED is true"
+            unless defined( $env->{$required} ) && $env->{$required} =~ /\S/;
+    }
+
+    my $instance = $env->{LIBKI_VIEWER_INSTANCE} // q{};
+    croak 'LIBKI_VIEWER_INSTANCE contains unsupported characters'
+        unless $instance =~ /\A[A-Za-z0-9_.-]{0,64}\z/;
+    my $origin = $env->{LIBKI_VIEWER_ORIGIN};
+    croak 'LIBKI_VIEWER_ORIGIN must be an HTTPS origin without a path'
+        unless $origin =~ m{\Ahttps://[A-Za-z0-9.-]+(?::[0-9]{1,5})?\z};
+    my $client_name = $env->{LIBKI_VIEWER_CLIENT_NAME};
+    croak 'LIBKI_VIEWER_CLIENT_NAME contains unsupported characters'
+        unless $client_name =~ /\A[A-Za-z0-9][A-Za-z0-9_.-]{0,63}\z/;
+
+    my $hmac_secret = _read_secret(
+        $env->{LIBKI_VIEWER_HMAC_FILE},
+        'viewer HMAC secret',
+        32,
+        4096,
+    );
+    my $vnc_password = _read_secret(
+        $env->{LIBKI_VIEWER_PASSWORD_FILE},
+        'viewer VNC password',
+        6,
+        8,
+    );
+    croak 'viewer VNC password must contain printable non-whitespace ASCII only'
+        unless $vnc_password =~ /\A[!-~]{6,8}\z/;
+
+    return {
+        enabled     => 1,
+        origin      => $origin,
+        instance    => $instance,
+        hmac_secret => $hmac_secret,
+        token_ttl   => 60,
+        clients     => {
+            $client_name => {
+                password => $vnc_password,
+            },
+        },
+    };
+}
+
+sub mint_token {
+    my ( $config, $client_name, $now ) = @_;
+
+    croak 'screen viewer is not enabled'
+        unless $config && $config->{enabled};
+    croak 'screen viewer client is not allowed'
+        unless defined($client_name) && $config->{clients}->{$client_name};
+
+    $now = time() unless defined $now;
+    my $expires = int($now) + ( $config->{token_ttl} // 60 );
+    my $nonce   = unpack( 'H*', _secure_random(16) );
+    my $payload = join q{.}, $client_name, $expires, $nonce;
+    my $signature = hmac_sha256_hex( $payload, $config->{hmac_secret} );
+
+    return "$payload.$signature";
+}
+
+sub _read_secret {
+    my ( $path, $label, $minimum, $maximum ) = @_;
+
+    open my $fh, '<:raw', $path
+        or croak "cannot open $label file: $!";
+    local $/;
+    my $value = <$fh>;
+    close $fh or croak "cannot close $label file: $!";
+
+    $value //= q{};
+    $value =~ s/[\r\n]+\z//;
+    my $length = length($value);
+    croak "$label length is outside the allowed range"
+        if $length < $minimum || $length > $maximum;
+
+    return $value;
+}
+
+sub _secure_random {
+    my ($length) = @_;
+
+    open my $fh, '<:raw', '/dev/urandom'
+        or croak "cannot open operating-system random source: $!";
+    my $buffer = q{};
+    while ( length($buffer) < $length ) {
+        my $read = read $fh, my $chunk, $length - length($buffer);
+        croak "cannot read operating-system random source: $!"
+            unless defined $read;
+        croak 'operating-system random source returned no data'
+            if $read == 0;
+        $buffer .= $chunk;
+    }
+    close $fh or croak "cannot close operating-system random source: $!";
+
+    return $buffer;
+}
+
+1;
