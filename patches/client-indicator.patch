+#ifndef SCREENVIEWINDICATOR_H
+#define SCREENVIEWINDICATOR_H
+
+#include <QWidget>
+
+class QLabel;
+class QTimer;
+
+class ScreenViewIndicator : public QWidget {
+  Q_OBJECT
+
+ public:
+  explicit ScreenViewIndicator(QWidget *parent = 0);
+  ~ScreenViewIndicator();
+
+ private slots:
+  void refreshConnectionState();
+
+ private:
+  enum ViewerConnectionState {
+    ViewerConnectionInactive,
+    ViewerConnectionActive,
+    ViewerConnectionDetectionFailed
+  };
+
+  ViewerConnectionState viewerConnectionState() const;
+  void positionBanner();
+  void keepBannerOnTop();
+
+  QTimer *pollTimer;
+  QLabel *titleLabel;
+  QLabel *detailLabel;
+  quint16 viewerPort;
+  bool indicatorEnabled;
+  ViewerConnectionState lastConnectionState;
+};
+
+#endif  // SCREENVIEWINDICATOR_H
