+                return await r.fulfill(json={'success':1,
+                    'action_mode':'reprint' if f['status']=='Done' else ('release' if f['status']=='Held' else 'none'),
+                    **{k:f[k] for k in ['filename','printer_name','pages','library_card','identifier_label']},
