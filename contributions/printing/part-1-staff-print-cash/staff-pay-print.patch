+            const result=await $.ajax({url:endpoint,method:'POST',dataType:'json',timeout:30000,headers:{'X-Requested-With':'XMLHttpRequest'},
+              data:{id:job.id,copies:job.preview.copies,cash_received:'1',expected_amount:job.preview.amount_due,request_id:job.requestId}});
+            const outcome=result.success ? 'Accepted by print system.' :
+              (result.manual_review || result.safe_to_retry===0 || result.safe_to_retry===false ? 'STATUS UNCERTAIN - check job status before retrying. ' : 'NOT released - ')+(result.error||'Unknown error');
+            $('<p>').text(description+outcome).appendTo(results);
+          } catch(error) {
+            sessionEnded=error.status===401;
+            $('<p>').text(description+(sessionEnded ? 'Staff session ended. ' : 'Request failed. ')+'Check job status before trying again; do not assume it did not print.').appendTo(results);
+          }
         }
+        selectedPrintJobs.clear();ForcePrintTableRefresh();
+        busy=false;finished=true;
+        modal.find('.print-submit').prop('disabled',true).hide();
+        modal.find('.print-total').text('Submission finished. Review each result below; reconcile collected cash for any unreleased or uncertain jobs.');
+        modal.find('.print-close').prop('disabled',false).text('Close');
+        modal.find('.print-cash').closest('label').hide();
       });
+    }
+    $('#print-table-row-toolbar-release').click(function(event) {
+      event.preventDefault();
+      // Historical completed jobs retain a separate, explicitly named Reprint.
+      const row=pTable.rows().data().toArray().find(row => String(row.DT_RowId)===String(window.selected_id));
+      if(row && row[1]==='Done') openPrintReview([String(window.selected_id)],false);
     });
 
