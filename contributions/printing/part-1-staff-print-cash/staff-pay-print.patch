+# Helper to build a mock user object
+sub build_mock_user {
+    my (%opts) = @_;
+
+    my $_funds                = $opts{funds}                // 10.00;
+    my $_gratis_print_balance = $opts{gratis_print_balance} // 0;
+    my $_id                   = $opts{id}                   // 1;
